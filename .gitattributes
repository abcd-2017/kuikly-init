# 强制 Windows 脚本使用 CRLF 行尾（cmd.exe 要求）
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Unix 脚本使用 LF
*.sh text eol=lf

# Kotlin/Gradle 文件
*.kts text eol=lf
*.kt text eol=lf
*.gradle text eol=lf
*.properties text eol=lf
*.xml text eol=lf
*.json text eol=lf
*.md text eol=lf
*.toml text eol=lf
*.ts text eol=lf
*.ets text eol=lf
